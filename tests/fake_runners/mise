#!/bin/sh

if [ "$1" != "run" ]; then
    echo "Expected 'run' subcommand" >&2
    exit 2
fi
shift

if [ "$1" = "--" ]; then
    shift
fi

task_name="$1"
shift

case "$task_name" in
    mise-build)
        echo "Mise build task executed successfully"
        ;;
    mise-file)
        printf 'Mise file task arguments: %s\n' "$*"
        ;;
    *)
        echo "Unknown mise task: $task_name" >&2
        exit 1
        ;;
esac
